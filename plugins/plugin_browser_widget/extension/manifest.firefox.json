{
  "manifest_version": 2,
  "name": "Телефон АТС — виджет для браузера",
  "version": "1.0.0",
  "description": "Звоните прямо из браузера: WebRTC-софтфон и click-to-call для CRM.",
  "permissions": ["storage", "contextMenus", "<all_urls>"],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "browser_action": {
    "default_title": "Телефон АТС",
    "default_icon": "icons/icon48.png"
  },
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": ["widget.html", "widget.js", "widget.css", "sip.js"],
  "content_security_policy": "script-src 'self' https://cdn.jsdelivr.net; object-src 'self'",
  "browser_specific_settings": {
    "gecko": {
      "id": "asterisk-widget@logiccore",
      "strict_min_version": "115.0"
    }
  }
}
